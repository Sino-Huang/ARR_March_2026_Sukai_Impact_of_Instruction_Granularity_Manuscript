\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces The x-axis are test instruction width, and the y-axis are training setup. Transfer is asymmetric: train coarse $\rightarrow $ test fine works, but train fine $\rightarrow $ test coarse does not. Mixed-granularity training improves generalization. \emph  {Axial-C} training setting performs best overall.}}{7}{figure.caption.4}\protected@file@percent }
\newlabel{fig:q3_cross_granularity}{{4}{7}{The x-axis are test instruction width, and the y-axis are training setup. Transfer is asymmetric: train coarse $\rightarrow $ test fine works, but train fine $\rightarrow $ test coarse does not. Mixed-granularity training improves generalization. \emph {Axial-C} training setting performs best overall}{figure.caption.4}{}}
\newlabel{fig:q3_cross_granularity@cref}{{[figure][4][]4}{[1][6][]7}{}{}{}}
