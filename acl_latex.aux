\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textsc  {Mini-BEHAVIOR-Gran} Experimental Pipeline. We evaluate the impact of instruction granularity across three VLA action-decoding strategies. During inference time, an Oracle Instructor evaluates the current world state to decide available rule set $\mathcal  R_a$ and active rule $r_t$. A rule-based natural language instruction $l_t$ is generated accordingly. The process iterates until completion or max steps.}}{5}{figure.caption.3}\protected@file@percent }
\newlabel{fig:experiment_illu}{{2}{5}{\textsc {Mini-BEHAVIOR-Gran} Experimental Pipeline. We evaluate the impact of instruction granularity across three VLA action-decoding strategies. During inference time, an Oracle Instructor evaluates the current world state to decide available rule set $\mathcal R_a$ and active rule $r_t$. A rule-based natural language instruction $l_t$ is generated accordingly. The process iterates until completion or max steps}{figure.caption.3}{}}
\newlabel{fig:experiment_illu@cref}{{[figure][2][]2}{[1][4][]5}{}{}{}}
