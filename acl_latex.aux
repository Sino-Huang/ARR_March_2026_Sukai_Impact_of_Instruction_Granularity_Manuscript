\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textsc  {Mini-BEHAVIOR-Gran} Experimental Pipeline. We evaluate the impact of instruction granularity across three VLA action-decoding strategies. During inference time, a dynamic instructor evaluates the current world state to decide available rule set $\mathcal  R_a$ and active rule $r_t$. A rule-based natural language instruction $l_t$ is generated accordingly. The process iterates until completion or max steps.}}{4}{figure.caption.4}\protected@file@percent }
\newlabel{fig:experiment_illu}{{3}{4}{\textsc {Mini-BEHAVIOR-Gran} Experimental Pipeline. We evaluate the impact of instruction granularity across three VLA action-decoding strategies. During inference time, a dynamic instructor evaluates the current world state to decide available rule set $\mathcal R_a$ and active rule $r_t$. A rule-based natural language instruction $l_t$ is generated accordingly. The process iterates until completion or max steps}{figure.caption.4}{}}
\newlabel{fig:experiment_illu@cref}{{[figure][3][]3}{[1][3][]4}{}{}{}}
