\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Smaller SR gaps indicate a shift towards shallow grounding. Under semantic perturbation, the Pure-C setting exhibits tiny variance ($2.8\%$) between \textit  {w/ goal lang} and \textit  {w/o lang}.}}{8}{figure.caption.9}\protected@file@percent }
\newlabel{fig:sr_diff_by_training_setup}{{7}{8}{Smaller SR gaps indicate a shift towards shallow grounding. Under semantic perturbation, the Pure-C setting exhibits tiny variance ($2.8\%$) between \textit {w/ goal lang} and \textit {w/o lang}}{figure.caption.9}{}}
\newlabel{fig:sr_diff_by_training_setup@cref}{{[figure][7][]7}{[1][7][]8}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Layer-wise (32) attention trends derived from action tokens. Three trends: \textbf  {T1} (lang attn $\uparrow $ from $F \to M$), \textbf  {T2} (lang attn $\downarrow $ from $M \to C$), and \textbf  {T3} (vis attn $\uparrow $ from $M \to C$). Stats significance is denoted by $^{*}p < 0.05$ and $^{**}p < 0.01$ (See \Cref  {app_sec:full_attention_analysis_table} for full table). Diffusion and AR models' T1 and T2/T3 trends supports the hypothesis that \emph  {C} lang incentivizes shallow grounding.}}{8}{figure.caption.10}\protected@file@percent }
\newlabel{tab:attention_trends_main}{{4}{8}{Layer-wise (32) attention trends derived from action tokens. Three trends: \textbf {T1} (lang attn $\uparrow $ from $F \to M$), \textbf {T2} (lang attn $\downarrow $ from $M \to C$), and \textbf {T3} (vis attn $\uparrow $ from $M \to C$). Stats significance is denoted by $^{*}p < 0.05$ and $^{**}p < 0.01$ (See \Cref {app_sec:full_attention_analysis_table} for full table). Diffusion and AR models' T1 and T2/T3 trends supports the hypothesis that \emph {C} lang incentivizes shallow grounding}{figure.caption.10}{}}
\newlabel{tab:attention_trends_main@cref}{{[table][4][]4}{[1][7][]8}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Success rate (\%) across training setups and test granularities. Numbers in parentheses indicate task coverage at each width. For Pure models, cells where test width was unseen during training measure zero-shot transfer. Transfer is asymmetric: coarse $\rightarrow $ fine succeeds.}}{8}{figure.caption.10}\protected@file@percent }
\newlabel{tab:q3_cross_granularity}{{5}{8}{Success rate (\%) across training setups and test granularities. Numbers in parentheses indicate task coverage at each width. For Pure models, cells where test width was unseen during training measure zero-shot transfer. Transfer is asymmetric: coarse $\rightarrow $ fine succeeds}{figure.caption.10}{}}
\newlabel{tab:q3_cross_granularity@cref}{{[table][5][]5}{[1][7][]8}{}{}{}}
